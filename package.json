{
  "name": "attune",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts --manifest public/content/recordings.json",
    "adapt:content": "tsx scripts/adapt-metadata.ts",
    "build": "npm run typecheck && vite build",
    "check:bundle": "tsx scripts/check-bundle-size.ts dist 358400",
    "verify": "npm run validate:content && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@types/three": "0.185.1",
    "@types/webxr": "0.5.24",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
